// Module 01: Quản lý Lead & Pipeline kinh doanh (DFD 1.0 & 2.0, UC01, UC02, Brief Mini CRM)
// Owner: Nhóm 1 (01-leads)

model Product {
  id            Int           @id @default(autoincrement())
  categoryGroup String        @map("category_group") // 'led_screen' | 'electronic_board' | 'other'
  productCode   String        @unique @map("product_code")
  productName   String        @map("product_name")
  unit          String        @default("m2")
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at")
  leadProducts  LeadProduct[]

  @@index([categoryGroup, isActive])
  @@map("products")
}

model Lead {
  id                    Int     @id @default(autoincrement())
  leadCode              String  @unique @map("lead_code")
  version               Int     @default(1) // Optimistic concurrency control cho nhận/chuyển/đổi trạng thái Lead
  companyName           String? @map("company_name")
  projectName           String? @map("project_name") // UC01: Tên dự án
  normalizedLookupKey   String? @map("normalized_lookup_key") // UC01 4.1: Chuẩn hóa để check trùng Công ty/Dự án
  // Cho phép null khi tiếp nhận tự động từ form web (chỉ có SĐT + email) hoặc tạo nhanh Hotline/Zalo (Q05: không điền dữ liệu giả)
  contactName           String? @map("contact_name")
  phone                 String // Không đặt @unique vì một SĐT có thể có nhiều Lead hợp lệ theo thời gian/dự án
  isPhoneUnstandardized Boolean @default(false) @map("is_phone_unstandardized") // UC01 E2: SĐT chưa chuẩn hóa
  email                 String?
  contactChannel        String  @map("contact_channel") // 'hotline' | 'form_web' | 'email' | 'fanpage' | 'zalo' | 'google_lead_form'
  sourceWebsite         String? @map("source_website") // 'toantrung.com.vn' | 'bangled.vn' | 'manhinhled.net.vn' | ...
  selfReportedSource    String? @map("self_reported_source") // UC01/UC03: Nguồn khách tự khai (chỉ lưu đối chiếu)
  areaType              String? @map("area_type") // 'tphcm' | 'other_province' (bổ sung sau khi tạo nhanh/webhook)
  province              String? // Tỉnh/thành (bổ sung sau khi tạo nhanh/webhook)
  district              String?
  installationAddress   String? @map("installation_address")
  pipelineStatus        String  @default("new_lead") @map("pipeline_status") // 'new_lead' | 'quoting' | 'quote_sent' | 'won' | 'lost'
  lostReason            String? @map("lost_reason") // UC02: Bắt buộc khi chuyển sang 'lost'

  // Trường tài chính giữ ở DB dưới dạng BigInt (đơn vị VNĐ nguyên) nhưng chưa tự động phơi bày trên UI (Q08 đang mở)
  currencyCode  String  @default("VND") @map("currency_code")
  quoteValueVnd BigInt? @map("quote_value") // UC02 3.1: Giá trị báo giá (VNĐ)
  dealValueVnd  BigInt? @map("deal_value") // UC02 3.1: Giá trị chốt (VNĐ)

  assignedSalesId    Int?    @map("assigned_sales_id")
  // Nguồn gốc tác nhân tạo Lead: tránh gán Admin giả cho Lead tự động từ Webhook (PERMISSIONS.md & Q12)
  createdByUserId    Int?    @map("created_by_user_id")
  createdByActorType String  @default("user") @map("created_by_actor_type") // 'user' | 'webhook' | 'system'
  createdByActorRef  String? @map("created_by_actor_ref") // VD: 'user:2' | 'webhook:toantrung.com.vn' | 'webhook:google_lead_form'
  receivedByUserId   Int?    @map("received_by_user_id") // UC01 Bước 9: Xác nhận tiếp nhận

  // Cảnh báo trùng lặp, dò giá & Spam (UC01 4.1, 4.4, 4.5, Brief Mini CRM)
  isDuplicateAlert       Boolean @default(false) @map("is_duplicate_alert")
  duplicateStatus        String  @default("none") @map("duplicate_status") // 'none' | 'duplicate_red' | 'has_old_lead' | 'same_phone_email'
  matchedOldLeadId       Int?    @map("matched_old_lead_id")
  isSuspectedPriceCheck  Boolean @default(false) @map("is_suspected_price_check") // UC01 4.5: Cờ Nghi ngờ dò giá
  isSpam                 Boolean @default(false) @map("is_spam") // UC01 4.4: Cờ Spam (tách khỏi Pipeline chính)
  spamReason             String? @map("spam_reason")
  spamAdsExclusionStatus String  @default("none") @map("spam_ads_exclusion_status") // 'none' | 'auto_excluded' | 'pending_confirm' | 'confirmed_excluded' | 'restored'

  // SLA, mở lại, theo dõi phản hồi báo giá & luân chuyển tự động (UC01 Bước 9-12, UC02 2a, 4.1, DFD 2.0)
  autoReassignCount     Int       @default(0) @map("auto_reassign_count") // Tối đa N lần, sau đó gắn cờ Quản lý
  needsManagerAttention Boolean   @default(false) @map("needs_manager_attention") // UC01 Bước 12 / E8: Cờ Cần Quản lý xử lý
  reopenCount           Int       @default(0) @map("reopen_count") // UC02 2a: Mở lại tối đa 1 lần trong X ngày
  contactedAt           DateTime  @default(now()) @map("contacted_at") // UC01: Thời điểm khách liên hệ
  receivedAt            DateTime? @map("received_at") // UC01 Bước 9: Thời điểm bấm Xác nhận tiếp nhận
  firstQuoteSentAt      DateTime? @map("first_quote_sent_at") // UC02: Mốc gửi báo giá lần đầu
  quoteRespondedAt      DateTime? @map("quote_responded_at") // DFD 2.0 / Q09: Mốc khách phản hồi sau khi nhận báo giá
  lastQuoteReminderAt   DateTime? @map("last_quote_reminder_at") // Chống nhắc lặp cảnh báo báo giá quá 7 ngày
  statusChangedAt       DateTime  @default(now()) @map("status_changed_at") // UC02 4.1: Mốc đổi trạng thái gần nhất
  closedAt              DateTime? @map("closed_at") // UC02: Mốc đóng won/lost
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  assignedSales    User?              @relation("LeadAssignedSales", fields: [assignedSalesId], references: [id], onDelete: SetNull)
  createdBy        User?              @relation("LeadCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  receivedBy       User?              @relation("LeadReceivedBy", fields: [receivedByUserId], references: [id], onDelete: SetNull)
  matchedOldLead   Lead?              @relation("LeadDuplicateHistory", fields: [matchedOldLeadId], references: [id], onDelete: SetNull)
  duplicateLeads   Lead[]             @relation("LeadDuplicateHistory")
  leadProducts     LeadProduct[]
  attachments      LeadAttachment[]
  activities       LeadActivity[]
  priceCheckAlerts PriceCheckAlert[]
  tracking         MarketingTracking?
  designRequests   DesignRequest[]

  @@index([phone])
  @@index([email])
  @@index([normalizedLookupKey])
  @@index([pipelineStatus, isSpam])
  @@index([isSpam, spamAdsExclusionStatus])
  @@index([assignedSalesId, pipelineStatus])
  @@index([createdAt])
  @@map("leads")
}

model LeadProduct {
  id                 Int      @id @default(autoincrement())
  leadId             Int      @map("lead_id")
  productId          Int      @map("product_id")
  customProductName  String?  @map("custom_product_name") // Brief Mini CRM: Ô nhập thông tin khi chọn "Khác"
  requestedDimension String?  @map("requested_dimension") // Kích thước yêu cầu (VD: Ngang 4m x Cao 2.5m)
  noteSpecification  String?  @map("note_specification")
  createdAt          DateTime @default(now()) @map("created_at")
  lead               Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  product            Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([leadId])
  @@index([productId])
  @@map("lead_products")
}

model LeadAttachment {
  id             Int      @id @default(autoincrement())
  leadId         Int      @map("lead_id")
  attachmentType String   @map("attachment_type") // 'site_photo' | 'customer_drawing_doc'
  folderPath     String?  @map("folder_path") // UC01 4.3: Giữ cấu trúc thư mục con của bộ hồ sơ dự án
  fileName       String   @map("file_name")
  fileUrl        String   @map("file_url") // Lưu storage key riêng tư, tải qua API kiểm tra quyền ATTACHMENT_UPLOAD_VIEW
  fileSizeKb     Int      @map("file_size_kb")
  uploadedById   Int      @map("uploaded_by")
  uploadedAt     DateTime @default(now()) @map("uploaded_at")
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  uploadedBy     User     @relation("LeadAttachmentUploadedBy", fields: [uploadedById], references: [id])

  @@index([leadId, attachmentType])
  @@map("lead_attachments")
}

model LeadActivity {
  id             Int      @id @default(autoincrement())
  leadId         Int      @map("lead_id")
  actionType     String   @map("action_type") // 'create_lead' | 'confirm_receive' | 'update_info' | 'reassign_sales' | 'auto_reassign' | 'status_change' | 'reopen_lead' | 'mark_spam' | 'restore_spam' | 'price_check_alert' | 'upload_attachment' | 'add_note' | 'tracking_update'
  fromSalesId    Int?     @map("from_sales_id")
  toSalesId      Int?     @map("to_sales_id")
  transferReason String?  @map("transfer_reason") // UC01 6a / UC02 2b: Lý do chuyển Lead
  oldStatus      String?  @map("old_status")
  newStatus      String?  @map("new_status")
  oldValueJson   String?  @map("old_value_json") // UC01 6b / UC03 Luồng C: Giá trị cũ khi sửa
  newValueJson   String?  @map("new_value_json") // Giá trị mới khi sửa
  note           String?
  actionById     Int?     @map("action_by") // Nullable khi tác nhân là webhook hoặc job hệ thống tự động
  actorType      String   @default("user") @map("actor_type") // 'user' | 'webhook' | 'system'
  actorRef       String?  @map("actor_ref")
  createdAt      DateTime @default(now()) @map("created_at")
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actionBy       User?    @relation("LeadActivityActor", fields: [actionById], references: [id], onDelete: SetNull)
  fromSales      User?    @relation("LeadActivityFromSales", fields: [fromSalesId], references: [id], onDelete: SetNull)
  toSales        User?    @relation("LeadActivityToSales", fields: [toSalesId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([actionById])
  @@map("lead_activities")
}

model PriceCheckAlert {
  id                  Int       @id @default(autoincrement())
  leadId              Int       @map("lead_id")
  phone               String
  companyName         String?   @map("company_name")
  normalizedLookupKey String?   @map("normalized_lookup_key")
  reason              String // UC01 4.5: Căn cứ xác định dò giá
  chatScreenshotUrl   String?   @map("chat_screenshot_url") // Storage key riêng tư của ảnh chụp nội dung chat minh chứng
  status              String    @default("active") // 'active' | 'removed'
  previousAlertId     Int?      @map("previous_alert_id") // UC01 4.5: Lưu vết khi tạo lại sau khi gỡ
  createdByUserId     Int       @map("created_by_user_id")
  removedByUserId     Int?      @map("removed_by_user_id")
  removedAt           DateTime? @map("removed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  lead                Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy           User      @relation("PriceCheckCreatedBy", fields: [createdByUserId], references: [id])
  removedBy           User?     @relation("PriceCheckRemovedBy", fields: [removedByUserId], references: [id], onDelete: SetNull)

  @@index([phone, status])
  @@index([normalizedLookupKey, status])
  @@index([leadId])
  @@map("price_check_alerts")
}

// Module 02: Tracking nguồn và đồng bộ dữ liệu (DFD 3.0, Kho D3, UC03)
// Owner: Nhóm 2 (02-tracking-sync)

model Campaign {
  id                Int                   @id @default(autoincrement())
  platform          String                @default("google_ads") // 'google_ads' | 'facebook' | 'zalo' | 'other'
  accountExternalId String                @default("default") @map("account_external_id") // Phân biệt nhiều tài khoản quảng cáo
  campaignCode      String                @map("campaign_code")
  campaignName      String                @map("campaign_name")
  utmCampaignSlug   String?               @map("utm_campaign_slug") // UC03 A3: Đối chiếu với utm_campaign
  currencyCode      String                @default("VND") @map("currency_code")
  dailyBudgetMicros BigInt?               @map("daily_budget_micros") // 1 đơn vị tiền tệ = 1,000,000 micros (giữ nguyên độ chính xác Google Ads)
  isActive          Boolean               @default(true) @map("is_active")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  trackings         MarketingTracking[]
  dailyMetrics      PlatformDailyMetric[]

  @@unique([platform, accountExternalId, campaignCode], name: "uq_campaign_platform_account_code")
  @@index([utmCampaignSlug])
  @@index([platform, isActive])
  @@map("campaigns")
}

model MarketingTracking {
  id                     Int     @id @default(autoincrement())
  leadId                 Int     @unique @map("lead_id") // Quan hệ 1-1 với bảng leads theo BA ERD
  campaignId             Int?    @map("campaign_id")
  intakeChannel          String  @default("form_web") @map("intake_channel") // UC03 BR6: Kênh tiếp nhận ('form_web' | 'google_lead_form' | 'hotline' | 'zalo' | 'fanpage' | 'email')
  // Định danh chống lặp (Idempotency) phân tách theo đúng nguồn/tài khoản/website + mã sự kiện
  intakeSourceProvider   String  @default("manual") @map("intake_source_provider") // 'website_webhook' | 'google_lead_form' | 'manual'
  intakeSourceAccountKey String  @default("internal") @map("intake_source_account_key") // VD: 'toantrung.com.vn' | 'bangled.vn' | 'manhinhled.net.vn' | 'gads:123-456-7890'
  externalSubmissionId   String? @map("external_submission_id") // Submission ID / Google Lead ID trong phạm vi nguồn đó

  marketingSource        String  @default("Chưa xác định") @map("marketing_source") // UC03 Luồng A: 'Google Ads' | 'Tìm kiếm tự nhiên' | 'Mạng xã hội' | 'Website giới thiệu' | 'Truy cập trực tiếp' | 'Khác' | 'Chưa xác định' | 'Nhập tay'
  sourceResolutionMethod String  @default("unknown") @map("source_resolution_method") // UC03 Bước 3: 'google_lead_form' | 'gclid' | 'gclid_retried' | 'utm_temp' | 'utm' | 'referrer' | 'manual' | 'unknown'
  utmSource              String? @map("utm_source")
  utmMedium              String? @map("utm_medium")
  utmCampaign            String? @map("utm_campaign")
  campaignName           String? @map("campaign_name")
  gclid                  String?
  referrerUrl            String? @map("referrer_url")
  landingPageUrl         String? @map("landing_page_url")
  deviceType             String? @map("device_type")
  ipAddress              String? @map("ip_address") // Cấm gửi sang AI (DATA_SAFETY)
  geoLocation            String? @map("geo_location")

  // Các cờ kiểm soát chất lượng tracking theo UC03 (A1, A2, A3, BR2, BR4)
  isUnknownSource    Boolean   @default(false) @map("is_unknown_source") // Cờ Chưa xác định nguồn
  isUnknownCampaign  Boolean   @default(false) @map("is_unknown_campaign") // Cờ Chưa rõ chiến dịch
  isUtmGclidMismatch Boolean   @default(false) @map("is_utm_gclid_mismatch") // UC03 BR4: UTM lệch gclid
  isUnmatchedUtm     Boolean   @default(false) @map("is_unmatched_utm") // UC03 A3: UTM chưa khớp danh mục chiến dịch
  isRepeatLead       Boolean   @default(false) @map("is_repeat_lead") // UC03 BR2: Lead lặp trong X ngày (không tính trùng vào KPI Ads)
  gclidRetryCount    Int       @default(0) @map("gclid_retry_count") // UC03 A2: Thử lại trong 7 ngày
  gclidLastTriedAt   DateTime? @map("gclid_last_tried_at")
  syncGa4Status      String    @default("pending") @map("sync_ga4_status") // BA ERD: 'synced' | 'pending' | 'failed'
  trackedAt          DateTime  @default(now()) @map("tracked_at")

  lead     Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@unique([intakeSourceProvider, intakeSourceAccountKey, externalSubmissionId], name: "uq_tracking_source_submission")
  @@index([marketingSource])
  @@index([campaignId])
  @@index([gclid])
  @@index([isUnknownCampaign, trackedAt])
  @@index([trackedAt])
  @@map("marketing_tracking")
}

// Nguồn số liệu chuẩn duy nhất (Canonical Metric Store - Kho D3) cho cả M02, M03 và M04
model PlatformDailyMetric {
  id                   Int    @id @default(autoincrement())
  platform             String // 'google_ads' | 'ga4' | 'search_console' | 'fanpage' | 'google_trends'
  accountPropertyId    String @map("account_property_id") // Tài khoản Ads / GA4 Property / GSC Site URL / Fanpage ID
  metricDate           String @map("metric_date") // YYYY-MM-DD (UC03 Luồng B: chốt sổ T-1..T-7 / T-30)
  grain                String // 'account' | 'campaign' | 'keyword' | 'page' | 'topic'
  // Các khóa định danh chiều đã chuẩn hóa (không null, mặc định "" khi chiều đó không áp dụng cho grain)
  campaignExternalId   String @default("") @map("campaign_external_id")
  keywordMatchType     String @default("") @map("keyword_match_type") // 'EXACT' | 'PHRASE' | 'BROAD' | ''
  keywordTextNorm      String @default("") @map("keyword_text_norm") // Chữ thường đã trim
  pagePathNorm         String @default("") @map("page_path_norm")
  dimensionFingerprint String @map("dimension_fingerprint") // Chuỗi chuẩn hóa đầy đủ của toàn bộ chiều

  campaignId   Int?    @map("campaign_id")
  campaignName String? @map("campaign_name")
  keywordRaw   String? @map("keyword")
  pageUrlRaw   String? @map("page_url")

  // Tiền tệ lưu theo micros (BigInt: 1 đơn vị = 1,000,000 micros) để bảo toàn phần lẻ CPC/chi phí gốc từ Google Ads
  currencyCode      String  @default("VND") @map("currency_code")
  spendMicros       BigInt  @default(0) @map("spend_micros")
  dailyBudgetMicros BigInt? @map("daily_budget_micros")
  cpcMicros         BigInt? @map("cpc_micros")

  impressions         Int      @default(0)
  clicks              Int      @default(0)
  conversionsMicros   BigInt   @default(0) @map("conversions_micros") // Hỗ trợ chuyển đổi phân số (data-driven attribution)
  googleLeadFormCount Int      @default(0) @map("google_lead_form_count") // Dùng đối soát UC03 Luồng D
  pageViews           Int      @default(0) @map("page_views")
  avgTimeOnPageSec    Float    @default(0) @map("avg_time_on_page_sec")
  avgPosition         Float?   @map("avg_position")
  fanpageEngagements  Int      @default(0) @map("fanpage_engagements")
  trendInterestScore  Int?     @map("trend_interest_score")
  isFinalized         Boolean  @default(false) @map("is_finalized") // True khi đã qua cửa sổ chốt sổ
  syncedAt            DateTime @default(now()) @map("synced_at")

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@unique([platform, accountPropertyId, metricDate, grain, campaignExternalId, keywordMatchType, keywordTextNorm, pagePathNorm], name: "uq_platform_metric_scope")
  @@index([platform, metricDate, grain])
  @@index([platform, grain, metricDate])
  @@index([campaignId, metricDate])
  @@index([campaignId, grain])
  @@index([keywordTextNorm, metricDate])
  @@map("platform_daily_metrics")
}

model PlatformSyncLog {
  id                  Int       @id @default(autoincrement())
  platform            String // 'google_ads' | 'ga4' | 'search_console' | 'fanpage' | 'google_trends'
  accountPropertyId   String    @default("default") @map("account_property_id")
  runType             String    @default("full") @map("run_type") // 'full' | 'light' | 'gclid_retry'
  windowStartDate     String?   @map("window_start_date")
  windowEndDate       String?   @map("window_end_date")
  recordsSynced       Int       @default(0) @map("records_synced")
  status              String    @default("success") // 'success' | 'failed'
  errorMessage        String?   @map("error_message")
  consecutiveFailures Int       @default(0) @map("consecutive_failures") // UC03 E2: Cảnh báo Admin khi lỗi 3 lần liên tiếp
  startedAt           DateTime  @default(now()) @map("started_at")
  completedAt         DateTime? @map("completed_at")

  @@index([platform, accountPropertyId, startedAt])
  @@map("platform_sync_logs")
}

model LeadReconciliation {
  id                    Int       @id @default(autoincrement())
  reconcileDate         String    @map("reconcile_date") // YYYY-MM-DD (UC03 Luồng D: đối soát ngày T-1)
  platform              String    @default("google_ads") // 'google_ads' | 'ga4_web'
  accountPropertyId     String    @default("default") @map("account_property_id")
  crmLeadCount          Int       @default(0) @map("crm_lead_count")
  crmErrorLogCount      Int       @default(0) @map("crm_error_log_count")
  platformReportedCount Int       @default(0) @map("platform_reported_count")
  discrepancy           Int       @default(0)
  status                String    @default("ok") // 'ok' | 'alert_open' | 'resolved'
  resolvedByUserId      Int?      @map("resolved_by_user_id")
  resolutionNote        String?   @map("resolution_note") // UC03 Luồng D Bước 5: Ghi chú nguyên nhân lệch
  resolvedAt            DateTime? @map("resolved_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  resolvedBy            User?     @relation("ReconciliationResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@unique([reconcileDate, platform, accountPropertyId], name: "uq_reconcile_date_platform_account")
  @@index([status])
  @@map("lead_reconciliations")
}

model WebhookIntakeErrorLog {
  id                     Int       @id @default(autoincrement())
  sourcePlatform         String    @map("source_platform") // 'website_webhook' | 'google_lead_form'
  intakeSourceAccountKey String    @default("unknown") @map("intake_source_account_key") // VD: 'toantrung.com.vn' | 'gads:123'
  externalSubmissionId   String?   @map("external_submission_id")
  rawPayloadJson         String    @map("raw_payload_json")
  errorCode              String    @map("error_code")
  errorMessage           String    @map("error_message")
  retryCount             Int       @default(0) @map("retry_count")
  lastRetriedAt          DateTime? @map("last_retried_at")
  isResolved             Boolean   @default(false) @map("is_resolved")
  resolvedLeadId         Int?      @map("resolved_lead_id")
  createdAt              DateTime  @default(now()) @map("created_at")

  @@unique([sourcePlatform, intakeSourceAccountKey, externalSubmissionId], name: "uq_webhook_error_source_submission")
  @@index([sourcePlatform, createdAt])
  @@map("webhook_intake_error_logs")
}

// Module 03: Nội dung SEO tích hợp AI & Phân tích Từ khóa/Ads (DFD 5.0, Kho D4, UC05)
// Owner: Nhóm 3 (03-keywords-ads)
// Lưu ý: Nguồn số liệu gốc theo ngày nằm tại PlatformDailyMetric (M02). Các trường cached_* dưới đây là bộ nhớ đệm dẫn xuất (derived cache) có ghi rõ nguồn và kỳ tổng hợp.

model SeoKeyword {
  id                    Int       @id @default(autoincrement())
  keyword               String    @unique
  keywordNorm           String    @unique @map("keyword_norm")
  // Các chỉ số dẫn xuất từ PlatformDailyMetric (M02) với kỳ thời gian và nguồn xác định rõ ràng
  cachedSearchVolume    Int?      @map("cached_search_volume")
  cachedAdsClicks       Int?      @map("cached_ads_clicks")
  cachedOrganicClicks   Int?      @map("cached_organic_clicks")
  cachedAvgPosition     Float?    @map("cached_avg_position")
  cacheSourceAccountKey String?   @map("cache_source_account_key")
  cacheWindowStartDate  String?   @map("cache_window_start_date") // YYYY-MM-DD
  cacheWindowEndDate    String?   @map("cache_window_end_date") // YYYY-MM-DD
  cacheRefreshedAt      DateTime? @map("cache_refreshed_at")

  trendDirection           String       @default("stable") @map("trend_direction") // 'rising' | 'stable' | 'declining'
  recommendedPublishWindow String?      @map("recommended_publish_window") // UC05 Bước 2: Gợi ý thời điểm đăng bài tối ưu theo mùa vụ
  updatedAt                DateTime     @updatedAt @map("updated_at")
  articles                 SeoArticle[]

  @@index([trendDirection])
  @@map("seo_keywords")
}

model SeoArticle {
  id                  Int       @id @default(autoincrement())
  version             Int       @default(1) // Optimistic concurrency control
  keywordId           Int?      @map("keyword_id")
  topic               String // UC05 Bước 3: Chủ đề bài viết
  title               String
  slug                String?
  metaDescription     String?   @map("meta_description")
  aiSuggestedOutline  String?   @map("ai_suggested_outline") // UC05 Bước 4: Dàn ý chuẩn SEO do AI tạo
  contentHtml         String    @map("content_html")
  targetWebsite       String    @default("toantrung.com.vn") @map("target_website") // 'toantrung.com.vn' | 'bangled.vn' | 'manhinhled.net.vn'
  status              String    @default("draft") // UC05: 'draft' (Nháp) | 'approved_scheduled' (Đã duyệt - chờ đăng) | 'published' (Đã đăng)
  // Ràng buộc phiên bản được duyệt & đang hiện hành (UC05 Bước 6-8)
  currentRevisionId   Int?      @unique @map("current_revision_id")
  approvedRevisionId  Int?      @unique @map("approved_revision_id")
  scheduledPublishAt  DateTime? @map("scheduled_publish_at") // UC05 Bước 7: Lịch xuất bản
  publishedAt         DateTime? @map("published_at")
  publishedUrl        String?   @map("published_url")
  publishAttemptCount Int       @default(0) @map("publish_attempt_count")
  lastPublishError    String?   @map("last_publish_error") // UC05 E2: Lỗi kết nối Website khi tự động đăng

  // Hiệu quả sau đăng dẫn xuất từ GA4 / Search Console (UC05 Bước 9 & 9a)
  cachedOrganicClicks    Int?      @map("cached_organic_clicks")
  cachedAvgPosition      Float?    @map("cached_avg_position")
  cachedAvgTimeOnPageSec Float?    @map("cached_avg_time_on_page_sec")
  metricsRefreshedAt     DateTime? @map("metrics_refreshed_at")
  needsOptimization      Boolean   @default(false) @map("needs_optimization") // UC05 9a: Cờ Cần tối ưu lại sau 30 ngày

  createdByUserId  Int       @map("created_by_user_id")
  approvedByUserId Int?      @map("approved_by_user_id")
  approvedAt       DateTime? @map("approved_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  keyword          SeoKeyword?          @relation(fields: [keywordId], references: [id], onDelete: SetNull)
  createdBy        User                 @relation("SeoArticleCreatedBy", fields: [createdByUserId], references: [id])
  approvedBy       User?                @relation("SeoArticleApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  currentRevision  SeoArticleRevision?  @relation("SeoArticleCurrentRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)
  approvedRevision SeoArticleRevision?  @relation("SeoArticleApprovedRevision", fields: [approvedRevisionId], references: [id], onDelete: SetNull)
  revisions        SeoArticleRevision[] @relation("SeoArticleRevisionHistory")
  aiUsageLogs      AiUsageLog[]

  @@unique([targetWebsite, slug], name: "uq_seo_article_website_slug")
  @@index([status, scheduledPublishAt])
  @@index([targetWebsite, status])
  @@index([keywordId])
  @@map("seo_articles")
}

model SeoArticleRevision {
  id              Int      @id @default(autoincrement())
  articleId       Int      @map("article_id")
  revisionNumber  Int      @map("revision_number") // Số phiên bản tăng dần trong phạm vi mỗi bài viết
  originType      String   @default("human_edit") @map("origin_type") // 'ai_initial_draft' | 'human_edit'
  title           String
  metaDescription String?  @map("meta_description")
  contentHtml     String   @map("content_html")
  changeNote      String?  @map("change_note") // UC05 Bước 6: Lịch sử chỉnh sửa bài viết
  editedByUserId  Int      @map("edited_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  article            SeoArticle  @relation("SeoArticleRevisionHistory", fields: [articleId], references: [id], onDelete: Cascade)
  currentForArticle  SeoArticle? @relation("SeoArticleCurrentRevision")
  approvedForArticle SeoArticle? @relation("SeoArticleApprovedRevision")
  editedBy           User        @relation("SeoRevisionEditedBy", fields: [editedByUserId], references: [id])

  @@unique([articleId, revisionNumber], name: "uq_seo_article_revision_num")
  @@index([articleId, createdAt])
  @@map("seo_article_revisions")
}

// Module 04: Báo cáo, Dashboard & Xuất dữ liệu (DFD 4.0, UC04, Brief Mini CRM Mục 6)
// Owner: Nhóm 4 (04-reports)
// Theo quy tắc thiết kế tại docs/database/README.md và TABLE_OWNERSHIP.md:
// Module 04 chỉ đọc dữ liệu tổng hợp từ các kho D1 (M01), D3 (M02), D4 (M03), D5 (Core AiUsageLog), D6 (M05)
// thông qua read contract đã kiểm tra phạm vi quyền 8 vai trò BA.
// Không tạo bảng lưu trữ riêng mang tính suy đoán (như report_export_logs) khi BA chưa yêu cầu lưu lịch sử file xuất riêng biệt.
// Nhật ký kiểm toán các thao tác nhạy cảm (nếu cần) sử dụng bảng chung AuditLog trong core.prisma.

// Module 05: Hỗ trợ Thiết kế & Phối cảnh AI (DFD 6.0, Kho D6, BA ERD design_requests, UC06)
// Owner: Nhóm 5 (05-ai-design)

model DesignRequest {
  id                  Int       @id @default(autoincrement())
  version             Int       @default(1) // Optimistic concurrency control
  // Cho phép null khi Designer tạo Banner độc lập (UC06 Luồng phụ 2a); bắt buộc gắn Lead ở tầng nghiệp vụ khi dựng phối cảnh 3D công trình (Q14)
  leadId              Int?      @map("lead_id")
  requestedBySalesId  Int?      @map("requested_by_sales_id")
  assignedDesignerId  Int       @map("assigned_designer_id")
  requestType         String    @map("request_type") // BA ERD: '3d_perspective' | 'banner' | 'video_short'
  ledCategory         String?   @map("led_category") // UC06 Bước 3: Kiểu dáng / loại màn hình LED hoặc bảng điện tử
  screenDimensions    String?   @map("screen_dimensions") // BA ERD varchar(150): Kích thước thực tế
  aspectRatio         String?   @map("aspect_ratio") // UC06: Tỉ lệ khung hình
  installPositionJson String?   @map("install_position_json") // UC06 Bước 3: Tọa độ / vùng khoanh lắp đặt trên ảnh hiện trạng
  sitePhotoUrl        String?   @map("site_photo_url") // Storage key riêng tư của ảnh hiện trạng mặt bằng gốc
  prompt              String? // UC06 Bước 3: Prompt mô tả yêu cầu ánh sáng, góc nhìn, bối cảnh (cấm chứa PII khách hàng)
  designStatus        String    @default("pending") @map("design_status") // BA ERD: 'pending' | 'ai_drafting' | 'completed' | 'revision_needed'
  // Hai trường ERD gốc trỏ tới storage key của bản nháp AI mới nhất và bản hoàn thiện đã duyệt
  aiDraftImageUrl     String?   @map("ai_draft_image_url")
  finalRenderUrl      String?   @map("final_render_url")
  approvedVersionId   Int?      @unique @map("approved_version_id") // Ràng buộc chính xác phiên bản ấn phẩm được duyệt bàn giao
  // Tổng hợp thời gian/token/chi phí từ các lượt AiUsageLog thật (nullable khi chưa có hoặc nguồn không cung cấp)
  processingTimeMs    Int?      @map("processing_time_ms")
  tokenCost           Int?      @map("token_cost")
  totalCostMicros     BigInt?   @map("total_cost_micros") // 1 đơn vị tiền tệ = 1,000,000 micros
  costCurrency        String?   @map("cost_currency") // 'USD' | 'VND' theo đúng nguồn provider
  notes               String?
  createdAt           DateTime  @default(now()) @map("created_at")
  completedAt         DateTime? @map("completed_at")

  lead             Lead?                @relation(fields: [leadId], references: [id], onDelete: SetNull)
  requestedBySales User?                @relation("DesignRequestedBySales", fields: [requestedBySalesId], references: [id], onDelete: SetNull)
  assignedDesigner User                 @relation("DesignAssignedDesigner", fields: [assignedDesignerId], references: [id])
  approvedVersion  DesignAssetVersion?  @relation("DesignRequestApprovedVersion", fields: [approvedVersionId], references: [id], onDelete: SetNull)
  assetVersions    DesignAssetVersion[] @relation("DesignRequestVersionHistory")
  aiUsageLogs      AiUsageLog[]

  @@index([leadId])
  @@index([assignedDesignerId])
  @@index([requestedBySalesId])
  @@index([assignedDesignerId, designStatus])
  @@index([requestType, designStatus])
  @@map("design_requests")
}

// Thư viện ấn phẩm & Lịch sử phiên bản nháp AI / bản hoàn thiện (UC06 Bước 6-7 & 10a-11a)
model DesignAssetVersion {
  id               Int      @id @default(autoincrement())
  designRequestId  Int      @map("design_request_id")
  versionNumber    Int      @map("version_number") // Số phiên bản tăng dần trong phạm vi từng DesignRequest
  versionType      String   @map("version_type") // 'ai_draft' | 'final_render'
  storageObjectKey String   @map("storage_object_key") // Khóa lưu trữ riêng tư (kiểm tra quyền trước khi tải)
  mimeType         String   @default("image/png") @map("mime_type")
  fileSizeBytes    Int?     @map("file_size_bytes")
  promptUsed       String?  @map("prompt_used")
  parametersJson   String?  @map("parameters_json")
  aiUsageLogId     Int?     @unique @map("ai_usage_log_id") // Liên kết 1-1 với lượt gọi AI đã sinh ra bản nháp này
  uploadedByUserId Int      @map("uploaded_by_user_id")
  isApprovedFinal  Boolean  @default(false) @map("is_approved_final")
  createdAt        DateTime @default(now()) @map("created_at")

  designRequest      DesignRequest  @relation("DesignRequestVersionHistory", fields: [designRequestId], references: [id], onDelete: Cascade)
  approvedForRequest DesignRequest? @relation("DesignRequestApprovedVersion")
  aiUsageLog         AiUsageLog?    @relation(fields: [aiUsageLogId], references: [id], onDelete: SetNull)
  uploadedBy         User           @relation("DesignAssetUploadedBy", fields: [uploadedByUserId], references: [id])

  @@unique([designRequestId, versionNumber], name: "uq_design_request_version_num")
  @@index([designRequestId, versionType])
  @@map("design_asset_versions")
}

// Core schema (DFD 7.0 & Shared D5 AI Usage Log: Users, Roles, Sessions, Notifications, System/Branding Settings, Audit Trail, AI Usage)
// Five business modules (01-leads .. 05-ai-design) own their dedicated .prisma files in this folder.

model Role {
  id          Int      @id @default(autoincrement())
  roleCode    String   @unique @map("role_code")
  roleName    String   @map("role_name")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  users       User[]

  @@map("roles")
}

model User {
  id               Int             @id @default(autoincrement())
  roleId           Int             @map("role_id")
  fullName         String          @map("full_name")
  email            String          @unique
  phone            String?
  passwordHash     String          @map("password_hash")
  department       String          @default("sales") // 'marketing' | 'sales' | 'management' | 'admin'
  specialtyGroup   String?         @map("specialty_group") // 'led_screen' | 'electronic_board' | 'other' (UC01/UC02: phân bổ theo nhóm SP thế mạnh)
  isReceivingLeads Boolean         @default(true) @map("is_receiving_leads") // UC01/UC02: trạng thái nhận Lead (tách khỏi is_active)
  isOnline         Boolean         @default(false) @map("is_online") // UC01/UC02: trạng thái online khi điều phối
  avatarUrl        String?         @map("avatar_url")
  isActive         Boolean         @default(true) @map("is_active")
  deletedAt        DateTime?       @map("deleted_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  role             Role            @relation(fields: [roleId], references: [id])
  sessions         UserSession[]
  notifications    Notification[]
  uploadedAssets   BrandingAsset[]
  auditLogs        AuditLog[]
  aiUsageLogs      AiUsageLog[]    @relation("AiUsageUser")

  // Quan hệ ngược sang Module 01 (Quản lý Lead & Pipeline)
  assignedLeads           Lead[]            @relation("LeadAssignedSales")
  createdLeads            Lead[]            @relation("LeadCreatedBy")
  receivedLeads           Lead[]            @relation("LeadReceivedBy")
  uploadedLeadAttachments LeadAttachment[]  @relation("LeadAttachmentUploadedBy")
  leadActivities          LeadActivity[]    @relation("LeadActivityActor")
  activitiesFromSales     LeadActivity[]    @relation("LeadActivityFromSales")
  activitiesToSales       LeadActivity[]    @relation("LeadActivityToSales")
  priceCheckAlertsCreated PriceCheckAlert[] @relation("PriceCheckCreatedBy")
  priceCheckAlertsRemoved PriceCheckAlert[] @relation("PriceCheckRemovedBy")

  // Quan hệ ngược sang Module 02 (Tracking & Đồng bộ)
  resolvedReconciliations LeadReconciliation[] @relation("ReconciliationResolvedBy")

  // Quan hệ ngược sang Module 03 (Nội dung SEO tích hợp AI)
  seoArticlesCreated  SeoArticle[]         @relation("SeoArticleCreatedBy")
  seoArticlesApproved SeoArticle[]         @relation("SeoArticleApprovedBy")
  seoArticleRevisions SeoArticleRevision[] @relation("SeoRevisionEditedBy")

  // Quan hệ ngược sang Module 05 (Hỗ trợ Thiết kế & Phối cảnh AI)
  designRequestsCreated       DesignRequest[]      @relation("DesignRequestedBySales")
  designRequestsAssigned      DesignRequest[]      @relation("DesignAssignedDesigner")
  designAssetVersionsUploaded DesignAssetVersion[] @relation("DesignAssetUploadedBy")

  @@index([roleId])
  @@index([department, isActive, isReceivingLeads])
  @@index([deletedAt])
  @@map("users")
}

model UserSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique @map("token_hash")
  csrfToken String    @map("csrf_token")
  userId    Int       @map("user_id")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Notification {
  id                 Int       @id @default(autoincrement())
  userId             Int       @map("user_id")
  title              String
  summary            String
  category           String    @default("Hệ thống")
  actionLabel        String?   @map("action_label")
  actionUrl          String?   @map("action_url")
  requiredPermission String?   @map("required_permission")
  isRead             Boolean   @default(false) @map("is_read")
  readAt             DateTime? @map("read_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model BrandingAsset {
  id            Int      @id @default(autoincrement())
  slot          String // 'logo' | 'login_hero' | 'dashboard_banner'
  objectKey     String   @unique @map("object_key")
  mimeType      String   @map("mime_type")
  fileSizeBytes Int      @map("file_size_bytes")
  width         Int
  height        Int
  sha256        String
  altText       String   @map("alt_text")
  coverPosition String   @default("center") @map("cover_position")
  cropJson      String?  @map("crop_json")
  isActive      Boolean  @default(true) @map("is_active")
  uploadedById  Int      @map("uploaded_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  uploadedBy    User     @relation(fields: [uploadedById], references: [id])

  @@index([slot, isActive])
  @@map("branding_assets")
}

model SystemSetting {
  key         String   @id
  value       String
  updatedById Int?     @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  actorUserId Int?     @map("actor_user_id")
  action      String
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id")
  detailsJson String?  @map("details_json")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Kho D5 trong DFD: Nhật ký sử dụng AI dùng chung (Owner ghi: Core contract; Consumer phát sinh: M03 & M05; Đọc báo cáo: M04)
model AiUsageLog {
  id                Int      @id @default(autoincrement())
  idempotencyKey    String   @unique @map("idempotency_key") // Chống nhân bản khi callback lặp nhưng giữ riêng từng lần thử thật
  attemptNumber     Int      @default(1) @map("attempt_number")
  providerRequestId String?  @map("provider_request_id")
  moduleCode        String   @map("module_code") // '03-keywords-ads' | '05-ai-design'
  taskType          String   @map("task_type") // 'seo_outline' | 'seo_draft' | '3d_perspective' | 'banner'
  userId            Int      @map("user_id")
  designRequestId   Int?     @map("design_request_id")
  seoArticleId      Int?     @map("seo_article_id")
  modelName         String   @default("gemini-2.5-flash") @map("model_name")
  // Nullable khi provider không trả về hoặc lượt gọi lỗi/timeout (DATA_SAFETY: không ghi số 0 giả)
  promptTokens      Int?     @map("prompt_tokens")
  completionTokens  Int?     @map("completion_tokens")
  totalTokens       Int?     @map("total_tokens")
  costMicros        BigInt?  @map("cost_micros") // 1 đơn vị tiền tệ = 1,000,000 micros (giữ nguyên phần lẻ, không tự quy đổi tỷ giá)
  costCurrency      String?  @map("cost_currency") // 'USD' | 'VND' theo đúng đơn vị provider trả về
  durationMs        Int?     @map("duration_ms") // Ghi nhận mỗi khi đo được, kể cả khi failed/timeout
  status            String   @default("success") // 'success' | 'failed' | 'timeout'
  errorMessage      String?  @map("error_message")
  createdAt         DateTime @default(now()) @map("created_at")

  user               User                @relation("AiUsageUser", fields: [userId], references: [id])
  designRequest      DesignRequest?      @relation(fields: [designRequestId], references: [id], onDelete: SetNull)
  seoArticle         SeoArticle?         @relation(fields: [seoArticleId], references: [id], onDelete: SetNull)
  designAssetVersion DesignAssetVersion?

  @@index([moduleCode, createdAt])
  @@index([userId, createdAt])
  @@index([designRequestId])
  @@index([seoArticleId])
  @@map("ai_usage_logs")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
  output          = "../generated/postgres-client"
}

datasource db {
  provider = "postgresql"
  url      = env("PG_DATABASE_URL")
}
